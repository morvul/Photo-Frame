# ============================================================
# Локальные данные рамок и машин — ШАБЛОН.
#
# Скопируйте этот файл рядом под именем "local.env" (без ".template")
# и заполните своими значениями:
#
#     cp scripts/local.env.template scripts/local.env
#
# Сам local.env в .gitignore и в репозиторий не попадает: в нём адреса
# рамок, имена машин и путь к ключу отладки. Скрипты подхватывают его
# сами (см. scripts/common.sh), а инструкции README.md и SETUP-wifiadb.md
# ссылаются на значения отсюда.
# ============================================================

# --- Рамки ---------------------------------------------------
# Адрес рамки в домашней сети: adb поверх Wi-Fi, порт 5555.
FRAME_ONE="<IP_РАМКИ_1>:5555"
FRAME_TWO="<IP_РАМКИ_2>:5555"

# Серийный номер рамки, подключённой по USB (виден в `adb devices`).
FRAME_SERIAL="<СЕРИЙНИК_РАМКИ>"

# --- Ключ отладки --------------------------------------------
# Путь к ключу adb на этой машине. Рамка не показывает запрос «разрешить
# отладку?» и принимает только тот ключ, который ей однажды скормили.
ADB_VENDOR_KEYS_PATH="<ПУТЬ_К_КЛЮЧУ>"

# Публичный ключ рабочей машины: его дописывают в /data/misc/adb/adb_keys
# на новой рамке. Это именно ПУБЛИЧНЫЙ ключ, приватный сюда не кладут.
DEPLOY_MACHINE_PUBLIC_KEY="<ПУБЛИЧНЫЙ_КЛЮЧ>"

# --- Имена машин ---------------------------------------------
# Машина, которой рамка уже доверяет: с неё настраивают новую рамку.
TRUSTED_HOST="<ИМЯ_ДОВЕРЕННОЙ_МАШИНЫ>"
# Рабочая машина, с которой идёт сборка и деплой.
MAIN_HOST="<ИМЯ_РАБОЧЕЙ_МАШИНЫ>"
