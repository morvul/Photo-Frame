<!--
	Шаблон локальных настроек. Скопируйте этот файл рядом как "secrets.props" и заполните.
	secrets.props добавлен в .gitignore и в репозиторий не попадает.
-->
<Project>
	<PropertyGroup>
		<!--
			Ссылка на публично расшаренный альбом Google Photos.
			Google Photos -> альбом -> Поделиться -> Создать ссылку.
			Подходит и короткая (photos.app.goo.gl/...), и полная (photos.google.com/share/...).
		-->
		<GooglePhotosShareUrl></GooglePhotosShareUrl>
	</PropertyGroup>

	<!--
		Home Assistant и Immich (оба необязательные) не берутся из secrets.props —
		оба дают полный доступ (к дому и к библиотеке снимков соответственно), а не
		к одному альбому, и вводятся прямо на рамке: настройки -> «Датчики» / «Immich».
	-->

	<!--
		Подпись релизного APK (необязательно). Без этого блока сборка подписывается
		отладочным ключом: такой APK ставится, но обновить его поверх получится
		только сборкой с тем же отладочным ключом. Для публикации нужен свой ключ:

			keytool -genkeypair -keystore photoframe-release.keystore -alias photoframe \
			        -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12

		Сам файл ключа держите вне репозитория (и сделайте резервную копию: без него
		обновления поверх установленного приложения невозможны).
	-->
	<!--
	<PropertyGroup>
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>C:\путь\photoframe-release.keystore</AndroidSigningKeyStore>
		<AndroidSigningStorePass>пароль хранилища</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>photoframe</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>пароль ключа</AndroidSigningKeyPass>
	</PropertyGroup>
	-->
</Project>
